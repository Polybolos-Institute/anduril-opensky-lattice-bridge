# Copy to .env and fill (never commit .env)
LATTICE_ENDPOINT=lattice-YOURENV.env.sandboxes.developer.anduril.com:443
LATTICE_CLIENT_ID=
LATTICE_CLIENT_SECRET=
LATTICE_ENV_TOKEN=

# OpenSky bbox (degrees). Default = DFW area.
# OPENSKY_LAMIN=32.5
# OPENSKY_LOMIN=-97.3
# OPENSKY_LAMAX=33.1
# OPENSKY_LOMAX=-96.4

# Optional OpenSky account (higher rate limit)
# OPENSKY_USER=
# OPENSKY_PASSWORD=

# Max aircraft to publish per poll (sandbox rate limits apply)
# MAX_TRACKS=25
# POLL_SEC=15
